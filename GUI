# ==============================CONVERSION COORDONNÉES==============================

def to_screen(x, y):
    sx = (x + 22) / 44 * 480 + 10
    sy = 150 - y / 22 * 130
    return sx, sy

# ==============================DESSINER LE FOND==============================

def dessiner_fond():
    ox, oy = to_screen(0, 0)
    canvas.create_line(10, oy, 490, oy, fill="lightgray")
    canvas.create_line(ox, 10, ox, 290, fill="lightgray")

    bx1, by1 = to_screen(-20, -20)
    bx2, by2 = to_screen(20, 20)
    canvas.create_rectangle(bx1, by1, bx2, by2, outline="black", width=2)

    canvas.create_text(to_screen(-20, 0)[0], oy + 12, text="-20", fill="gray", font=("Arial", 7))
    canvas.create_text(to_screen(20, 0)[0],  oy + 12, text="20",  fill="gray", font=("Arial", 7))
    canvas.create_text(ox - 14, to_screen(0, 20)[1],  text="20",  fill="gray", font=("Arial", 7))
    canvas.create_text(ox - 14, to_screen(0, -20)[1], text="-20", fill="gray", font=("Arial", 7))

# ==============================SÉVÉRITÉ==============================

def get_severite(g_max):
    if g_max < 5:
        texte = "COLLISION NON SÉVÈRE — Non fatale\nAucun risque majeur de blessure."
        couleur = "green"
    elif g_max < 20:
        texte = "COLLISION PEU SÉVÈRE — Blessures mineures possibles\nRisque faible de blessures légères."
        couleur = "#4caf50"
    elif g_max < 40:
        texte = "COLLISION MODÉRÉE — Blessures modérées probables\nConsultation médicale recommandée."
        couleur = "#b8860b"
    elif g_max < 80:
        texte = "COLLISION GRAVE — Blessures graves probables\nIntervention médicale urgente requise!"
        couleur = "orange"
    else:
        texte = "COLLISION MORTELLE — Survie peu probable\nPassagers morts!"
        couleur = "red"
    return texte, couleur

# ==============================AFFICHER RÉSULTATS PASSAGERS==============================

def afficher_passagers(delta_v1, delta_v2, mp1, mp2, d1, d2):
    a1 = (delta_v1 ** 2) / (2 * d1)
    a2 = (delta_v2 ** 2) / (2 * d2)

    F1 = mp1 * a1
    F2 = mp2 * a2

    if not ceinture1_var.get():
        F1 = F1 * 2
        a1 = a1 * 2

    if not ceinture2_var.get():
        F2 = F2 * 2
        a2 = a2 * 2

    g1 = a1 / 9.81
    g2 = a2 / 9.81

    texte = (
        f"Passager 1 — Ceinture: {'OUI ✓' if ceinture1_var.get() else 'NON ✗'}  |  "
        f"Déc.: {a1:.1f} m/s²  |  Force: {F1:.1f} N  |  G ressenti: {g1:.2f} g\n"
        f"Passager 2 — Ceinture: {'OUI ✓' if ceinture2_var.get() else 'NON ✗'}  |  "
        f"Déc.: {a2:.1f} m/s²  |  Force: {F2:.1f} N  |  G ressenti: {g2:.2f} g"
    )
    label_passagers.config(text=texte, fg="darkred")

    g_max = max(g1, g2)
    texte_sev, couleur_sev = get_severite(g_max)
    label_severite.config(text=texte_sev, fg=couleur_sev)

    def diagnostic_fatal(g):
        if g < 5:
            return "✅ NON FATALE — Aucun risque majeur"
        elif g < 20:
            return "⚠️ NON FATALE — Blessures mineures possibles"
        elif g < 40:
            return "🟠 NON FATALE — Blessures modérées probables"
        elif g < 80:
            return "🔴 POTENTIELLEMENT FATALE — Blessures graves"
        else:
            return "💀 FATALE — Force létale dépassée"

    diag1 = diagnostic_fatal(g1)
    diag2 = diagnostic_fatal(g2)

    def couleur_diag(g):
        if g < 5:
            return "green"
        elif g < 20:
            return "#4caf50"
        elif g < 40:
            return "#b8860b"
        elif g < 80:
            return "orange"
        else:
            return "red"

    texte_fatal = f"Véhicule 1 ({g1:.1f} g) : {diag1}\nVéhicule 2 ({g2:.1f} g) : {diag2}"

    if g1 >= g2:
        couleur_fatal = couleur_diag(g1)
    else:
        couleur_fatal = couleur_diag(g2)

    label_fatal.config(text=texte_fatal, fg=couleur_fatal)

# ==============================SIMULATION==============================

def lancer_simulation():
    global animation_id, derniers_resultats

    if animation_id is not None:
        fenetre.after_cancel(animation_id)

    try:
        m1 = float(entree_m1.get())
        if m1 <= 0:
            messagebox.showerror("Erreur", "La masse du véhicule 1 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Masse du véhicule 1 invalide ou vide!")
        return

    try:
        v1 = float(entree_v1.get())
    except ValueError:
        messagebox.showerror("Erreur", "Vitesse du véhicule 1 invalide ou vide!")
        return

    try:
        x1 = float(entree_x1.get())
    except ValueError:
        messagebox.showerror("Erreur", "Position X du véhicule 1 invalide ou vide!")
        return

    try:
        y1 = float(entree_y1.get())
    except ValueError:
        messagebox.showerror("Erreur", "Position Y du véhicule 1 invalide ou vide!")
        return

    try:
        a1 = float(entree_a1.get())
        if not (0 <= a1 <= 360):
            messagebox.showerror("Erreur", "L'angle du véhicule 1 doit être entre 0° et 360°!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Angle du véhicule 1 invalide ou vide!")
        return

    try:
        mp1 = float(entree_mp1.get())
        if mp1 <= 0:
            messagebox.showerror("Erreur", "La masse du passager 1 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Masse du passager 1 invalide ou vide!")
        return

    try:
        d1 = float(entree_distance1.get())
        if d1 <= 0:
            messagebox.showerror("Erreur", "La distance d'arrêt du véhicule 1 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Distance d'arrêt du véhicule 1 invalide ou vide!")
        return

    try:
        m2 = float(entree_m2.get())
        if m2 <= 0:
            messagebox.showerror("Erreur", "La masse du véhicule 2 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Masse du véhicule 2 invalide ou vide!")
        return

    try:
        v2 = float(entree_v2.get())
    except ValueError:
        messagebox.showerror("Erreur", "Vitesse du véhicule 2 invalide ou vide!")
        return

    try:
        x2 = float(entree_x2.get())
    except ValueError:
        messagebox.showerror("Erreur", "Position X du véhicule 2 invalide ou vide!")
        return

    try:
        y2 = float(entree_y2.get())
    except ValueError:
        messagebox.showerror("Erreur", "Position Y du véhicule 2 invalide ou vide!")
        return

    try:
        a2 = float(entree_a2.get())
        if not (0 <= a2 <= 360):
            messagebox.showerror("Erreur", "L'angle du véhicule 2 doit être entre 0° et 360°!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Angle du véhicule 2 invalide ou vide!")
        return

    try:
        mp2 = float(entree_mp2.get())
        if mp2 <= 0:
            messagebox.showerror("Erreur", "La masse du passager 2 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Masse du passager 2 invalide ou vide!")
        return

    try:
        d2 = float(entree_distance2.get())
        if d2 <= 0:
            messagebox.showerror("Erreur", "La distance d'arrêt du véhicule 2 doit être supérieure à 0!")
            return
    except ValueError:
        messagebox.showerror("Erreur", "Distance d'arrêt du véhicule 2 invalide ou vide!")
        return

    # Composantes de vitesse
    vx1 = v1 * math.cos(math.radians(a1))
    vy1 = v1 * math.sin(math.radians(a1))
    vx2 = v2 * math.cos(math.radians(a2))
    vy2 = v2 * math.sin(math.radians(a2))

    pos_x1 = x1
    pos_y1 = y1
    pos_x2 = x2
    pos_y2 = y2
    temps = 0.0
    dt = 0.05

    canvas.delete("all")
    label_collision.config(text="Simulation en cours...", fg="gray")
    label_passagers.config(text="")
    label_severite.config(text="")
    dessiner_fond()

    def animer():
        global animation_id, derniers_resultats
        nonlocal pos_x1, pos_y1, pos_x2, pos_y2, temps

        pos_x1 = pos_x1 + vx1 * dt
        pos_y1 = pos_y1 + vy1 * dt
        pos_x2 = pos_x2 + vx2 * dt
        pos_y2 = pos_y2 + vy2 * dt
        temps = temps + dt

        canvas.delete("voiture")

        sx1, sy1 = to_screen(pos_x1, pos_y1)
        canvas.create_oval(sx1 - 12, sy1 - 12, sx1 + 12, sy1 + 12,
                           fill="lightblue", outline="blue", width=2, tags="voiture")

        sx2, sy2 = to_screen(pos_x2, pos_y2)
        canvas.create_oval(sx2 - 12, sy2 - 12, sx2 + 12, sy2 + 12,
                           fill="#ffcccc", outline="red", width=2, tags="voiture")

        distance = math.sqrt((pos_x1 - pos_x2) ** 2 + (pos_y1 - pos_y2) ** 2)

        if distance < 0.1:
            vfx = (m1 * vx1 + m2 * vx2) / (m1 + m2)
            vfy = (m1 * vy1 + m2 * vy2) / (m1 + m2)
            vf = math.sqrt(vfx ** 2 + vfy ** 2)

            E_avant = 0.5 * m1 * v1 ** 2 + 0.5 * m2 * v2 ** 2
            E_apres = 0.5 * (m1 + m2) * vf ** 2
            E_dissipee = E_avant - E_apres

            delta_v1 = math.sqrt((vfx - vx1) ** 2 + (vfy - vy1) ** 2)
            delta_v2 = math.sqrt((vfx - vx2) ** 2 + (vfy - vy2) ** 2)

            a1_vehicule = (delta_v1 ** 2) / (2 * d1)
            a2_vehicule = (delta_v2 ** 2) / (2 * d2)

            F1_vehicule = m1 * a1_vehicule
            F2_vehicule = m2 * a2_vehicule

            g1_vehicule = a1_vehicule / 9.81
            g2_vehicule = a2_vehicule / 9.81

            angle_sortie = math.degrees(math.atan2(vfy, vfx))

            pcx, pcy = to_screen(pos_x1, pos_y1)

            if vf > 0.1:
                end_x = pos_x1 + (vfx / vf) * 8
                end_y = pos_y1 + (vfy / vf) * 8
                pe_x, pe_y = to_screen(end_x, end_y)
                canvas.create_line(pcx, pcy, pe_x, pe_y, fill="black", width=3, arrow=tk.LAST)
                canvas.create_text(pe_x, pe_y + 15, text="Vecteur de sortie",
                                   fill="black", font=("Arial", 8, "italic"))

            canvas.create_oval(pcx - 15, pcy - 15, pcx + 15, pcy + 15,
                               fill="yellow", outline="orange", width=2)
            canvas.create_text(pcx, pcy, text="IMPACT", fill="orange", font=("Arial", 8, "bold"))

            label_collision.config(
                text=(
                    f"Temps: {temps:.2f} s  |  Vitesse finale: {vf:.2f} m/s  |  "
                    f"Angle sortie: {angle_sortie:.1f}°  |  "
                    f"ΔV1: {delta_v1:.2f} m/s  |  ΔV2: {delta_v2:.2f} m/s\n"
                    f"F impact V1: {F1_vehicule:.1f} N  ({g1_vehicule:.2f} g)  |  "
                    f"F impact V2: {F2_vehicule:.1f} N  ({g2_vehicule:.2f} g)  |  "
                    f"Énergie perdue: {E_dissipee:.1f} J"
                ),
                fg="darkgreen"
            )

            derniers_resultats = (delta_v1, delta_v2, mp1, mp2, d1, d2)
            afficher_passagers(delta_v1, delta_v2, mp1, mp2, d1, d2)
            animation_id = None

        else:
            dehors1 = abs(pos_x1) > 20 or abs(pos_y1) > 20
            dehors2 = abs(pos_x2) > 20 or abs(pos_y2) > 20

            if dehors1 and dehors2:
                label_collision.config(
                    text="Aucune collision — Les deux véhicules ont quitté la zone.",
                    fg="gray"
                )
                label_passagers.config(text="")
                label_severite.config(text="")
                animation_id = None
            else:
                animation_id = fenetre.after(50, animer)

    animer()


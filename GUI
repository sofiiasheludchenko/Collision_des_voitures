    global animation_id, derniers_resultats

    if animation_id is not None:
        fenetre.after_cancel(animation_id)
        animation_id = None

    derniers_resultats = None

    for entree in [entree_m1, entree_v1, entree_x1, entree_y1, entree_a1, entree_mp1, entree_distance1,
                   entree_m2, entree_v2, entree_x2, entree_y2, entree_a2, entree_mp2, entree_distance2]:
        entree.delete(0, tk.END)

    ceinture1_var.set(True)
    btn_ceinture1.config(text="Ceinture P1: OUI", bg="#ccffcc", fg="green")
    ceinture2_var.set(True)
    btn_ceinture2.config(text="Ceinture P2: OUI", bg="#ccffcc", fg="green")

    canvas.delete("all")
    label_collision.config(text="\n", fg="gray")
    label_severite.config(text="\n")
    label_passagers.config(text="\n")
    label_fatal.config(text="\n")

bouton_stop = tk.Button(fenetre, text="Réinitialiser", command=reinitialiser,
